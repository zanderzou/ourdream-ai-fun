---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../data/site";
import heroImage from "../assets/ourdream-ai-companion-hero.png";

const posts = (await getCollection("blog")).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const faqs = [
  { question: "What is OurDream AI?", answer: "OurDream AI is an AI companion platform centered on customizable fictional characters, conversation, roleplay, and visual storytelling. Features and availability can change, so verify current details on the official website." },
  { question: "Is this the official OurDream AI website?", answer: "No. OurDream AI Guide is an independent editorial resource. Links marked official open the product's official website." },
  { question: "Is OurDream AI free?", answer: "Access and promotional credits may vary. Review the current official pricing and credit terms before starting a subscription or purchasing media generation credits." },
  { question: "Is OurDream AI safe to use?", answer: "Use fictional details, avoid confidential information, verify current retention and deletion controls, and treat AI companion chat as entertainment rather than private or professional advice." },
  { question: "What are the main OurDream AI alternatives?", answer: "Common comparison categories include Candy AI, GPTGirlfriend, character-chat platforms, and story-focused roleplay tools. Compare customization, continuity, media controls, privacy, and total cost." },
];
const jsonLd = { "@context":"https://schema.org", "@graph":[
  { "@type":"WebSite", "@id":`${site.url}/#website`, name:site.name, url:site.url, description:site.description, inLanguage:"en" },
  { "@type":"Organization", "@id":`${site.url}/#organization`, name:site.name, url:site.url, logo:`${site.url}/favicon.svg` },
  { "@type":"WebPage", "@id":`${site.url}/#webpage`, name:"OurDream AI Guide: Features, Privacy & Alternatives", url:site.url, isPartOf:{"@id":`${site.url}/#website`}, about:["OurDream AI","AI companion chat","AI character creator","roleplay"] },
  { "@type":"FAQPage", mainEntity:faqs.map((faq)=>({"@type":"Question",name:faq.question,acceptedAnswer:{"@type":"Answer",text:faq.answer}})) }
]};
---
<BaseLayout title="OurDream AI Guide: Features, Privacy & Alternatives" description={site.description} keywords={["OurDream AI","OurDream AI review","OurDream AI alternatives","AI companion","AI character creator"]} jsonLd={jsonLd}>
  <section class="hero">
    <Image class="hero-image" src={heroImage} alt="Clearly adult fictional AI companion in a neon rose digital lounge" widths={[640,960,1280,1536]} sizes="100vw" loading="eager" fetchpriority="high" quality={84} />
    <div class="hero-glow"></div>
    <div class="hero-copy reveal"><div class="kicker">Independent OurDream AI guide</div><h1>Design a character.<span>Build a whole world.</span></h1><p>Explore OurDream AI character creation, companion chat, visual storytelling, privacy questions, pricing considerations, and the best alternatives—before you commit.</p><div class="hero-actions"><a class="button primary" href="#features">Explore the experience <Icon name="spark" /></a><a class="button ghost" href="/blog/ourdream-ai-vs-candy-ai/">Read the comparison</a></div><div class="hero-trust"><span><Icon name="heart" /> Character-first</span><span><Icon name="chat" /> Story-focused</span><span><Icon name="lock" /> Privacy-aware</span><span>Independent review</span></div></div>
  </section>

  <section class="section intent-grid"><div><div class="section-label">01 / Understand the experience</div><h2>What makes <span>OurDream AI</span> different?</h2></div><div class="intent-copy"><p class="lead">OurDream AI is built around creating a fictional companion rather than simply opening a generic chatbot. Appearance, personality, conversation, and visual scenes work together as one story.</p><p>This independent OurDream AI guide helps you evaluate that experience using practical criteria: customization depth, roleplay continuity, image controls, credit costs, privacy, deletion, and how it compares with Candy AI and GPTGirlfriend.</p><div class="keyword-line"><span>OurDream AI review</span><span>AI companion chat</span><span>AI character creator</span><span>OurDream alternatives</span><span>roleplay privacy</span></div></div></section>

  <section class="section" id="features"><div class="section-head"><div><div class="section-label">02 / Core features</div><h2>From a profile to a<br /><span>living character.</span></h2></div><p>The strongest companion platforms connect character design, conversation, and visual direction without making the setup feel like a form.</p></div><div class="feature-grid">
    <article class="feature reveal"><div class="feature-icon"><Icon name="wand" /></div><h3>Character creation</h3><p>Shape appearance, personality, tone, and scenario so the first conversation begins with a clear identity.</p><a href="#story">See the workflow <Icon name="arrow" /></a></article>
    <article class="feature reveal"><div class="feature-icon"><Icon name="chat" /></div><h3>Companion chat</h3><p>Test how well the character maintains voice, remembers fictional details, and follows story direction over time.</p><a href="/blog/ourdream-ai-vs-gptgirlfriend/">Compare chat styles <Icon name="arrow" /></a></article>
    <article class="feature reveal"><div class="feature-icon"><Icon name="spark" /></div><h3>Visual storytelling</h3><p>Evaluate scene consistency, credit usage, image controls, and whether the media supports the character you designed.</p><a href="/blog/ourdream-ai-vs-candy-ai/">Compare visual tools <Icon name="arrow" /></a></article>
  </div></section>

  <section class="section story" id="story"><div class="story-board"><div class="character-card"><small>CHARACTER BLUEPRINT</small><h3>Mira / Midnight City</h3><div class="trait"><span>Personality</span><b>Curious · Witty</b></div><div class="trait"><span>Story style</span><b>Slow-burn mystery</b></div><div class="trait"><span>Visual mood</span><b>Neon noir</b></div><div class="trait"><span>Memory test</span><b>Fiction only</b></div></div></div><div class="story-copy"><div class="section-label">03 / Better character design</div><h2>Start with a premise,<br /><span>not a prompt dump.</span></h2><p>A concise character blueprint is easier for an AI companion to follow than a long list of conflicting traits.</p><ol class="steps"><li><span>01</span><div><strong>Choose one defining motivation</strong><p>Give the character a clear fictional goal that can drive several scenes.</p></div></li><li><span>02</span><div><strong>Add two compatible traits</strong><p>Pair characteristics that create a recognizable voice without constant contradiction.</p></div></li><li><span>03</span><div><strong>Define a safe story boundary</strong><p>Keep real identity details, private addresses, and confidential information outside the roleplay.</p></div></li></ol></div></section>

  <section class="section" id="compare"><div class="section-head"><div><div class="section-label">04 / Compare the options</div><h2>OurDream AI vs.<br /><span>leading alternatives.</span></h2></div><p>Compare the experience you will actually use—not just the number of characters shown on a landing page.</p></div><div class="compare-table"><table><thead><tr><th>Platform type</th><th>Best for</th><th>Creation style</th><th>Key question</th><th>Guide</th></tr></thead><tbody><tr><td><strong>OurDream AI</strong></td><td>Visual character building and story roleplay</td><td>Build and customize</td><td>How predictable are credits and controls?</td><td><span class="badge">Character-first</span></td></tr><tr><td><strong>Candy AI</strong></td><td>Guided companion discovery</td><td>Browse and refine</td><td>Which media features are in each plan?</td><td><a href="/blog/ourdream-ai-vs-candy-ai/">Full comparison →</a></td></tr><tr><td><strong>GPTGirlfriend</strong></td><td>Chat-first character exploration</td><td>Choose and converse</td><td>How consistent is longer roleplay?</td><td><a href="/blog/ourdream-ai-vs-gptgirlfriend/"><span class="badge alt">Compare chat</span></a></td></tr></tbody></table></div></section>

  <section class="section privacy" id="privacy"><div class="privacy-copy"><div class="section-label">05 / Privacy before intimacy</div><h2>Keep the story vivid.<br /><span>Keep your identity private.</span></h2><p>AI companion conversations can feel personal. Use fictional details, understand how history is stored, test deletion controls, and never treat an entertainment chatbot as confidential storage.</p><a class="button ghost" href="/blog/ourdream-ai-privacy-guide/">Open the privacy guide <Icon name="arrow" /></a></div><div class="privacy-card"><span>BEFORE YOU CHAT</span><h3>OurDream AI privacy checklist</h3><ul><li><b>01</b><span>Use a unique password and fictional profile details.</span></li><li><b>02</b><span>Check message, media, and account deletion controls.</span></li><li><b>03</b><span>Understand subscriptions, credits, and renewal.</span></li><li><b>04</b><span>Do not upload another person’s image without consent.</span></li><li><b>05</b><span>Keep medical, financial, and workplace secrets out.</span></li></ul></div></section>

  <section class="section"><div class="section-head"><div><div class="section-label">06 / OurDream AI blog</div><h2>Comparisons with<br /><span>real decision criteria.</span></h2></div><a class="button ghost" href="/blog/">Browse every guide <Icon name="arrow" /></a></div><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>

  <section class="section faq"><div><div class="section-label">07 / Frequently asked</div><h2>OurDream AI<br /><span>questions, answered.</span></h2></div><div class="faq-list">{faqs.map((faq)=><details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="section final-cta"><div><div class="section-label">MAKE THE COMPARISON YOURS</div><h2>Choose the experience<br />that fits your story.</h2><p>Start with character quality, privacy, and total cost. Then visit the official product only when you know what you want to test.</p></div><a class="button primary" href={site.officialUrl} rel="noopener" target="_blank">Visit official OurDream AI <Icon name="arrow" /></a></section>
</BaseLayout>
