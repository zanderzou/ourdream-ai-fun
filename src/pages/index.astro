---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../data/site";
import heroImage from "../assets/ourdream-user-character-editorial.png";
import secondaryImage from "../assets/ourdream-user-warm-character.png";

const posts = (await getCollection("blog")).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const faqs = [
  { question: "What is OurDream AI?", answer: "OurDream AI is an AI companion platform centered on customizable fictional characters, conversation, roleplay, and visual storytelling. Features and availability can change, so verify current details on the official website." },
  { question: "How do I compare OurDream AI character quality?", answer: "Create a fictional character and test the same identity through chat and any available media. Compare consistency, controls, response time, and current pricing." },
  { question: "Is OurDream AI free?", answer: "Access and promotional credits may vary. Review the current official pricing and credit terms before starting a subscription or purchasing media generation credits." },
  { question: "Is OurDream AI safe to use?", answer: "Use fictional details, avoid confidential information, verify current retention and deletion controls, and treat AI companion chat as entertainment rather than private or professional advice." },
  { question: "What are the main OurDream AI alternatives?", answer: "Candy AI, CrushOn AI, Lovescape, GirlfriendGPT, and Replika are five distinct options. Compare character creation, continuity, media controls, privacy, and full cost rather than treating them as interchangeable." },
];
const jsonLd = { "@context":"https://schema.org", "@graph":[
  { "@type":"WebSite", "@id":`${site.url}/#website`, name:site.name, url:site.url, description:site.description, inLanguage:"en" },
  { "@type":"Organization", "@id":`${site.url}/#organization`, name:site.name, url:site.url, logo:`${site.url}/favicon.svg` },
  { "@type":"WebPage", "@id":`${site.url}/#webpage`, name:"OurDream AI", url:site.url, isPartOf:{"@id":`${site.url}/#website`}, about:["OurDream AI","AI companion chat","AI character creator","roleplay"] },
  { "@type":"FAQPage", mainEntity:faqs.map((faq)=>({"@type":"Question",name:faq.question,acceptedAnswer:{"@type":"Answer",text:faq.answer}})) }
]};
---
<BaseLayout title="OurDream AI" description={site.description} keywords={["OurDream AI","OurDream AI review","OurDream AI alternatives","AI companion","AI character creator"]} jsonLd={jsonLd}>
  <section class="hero">
    <Image class="hero-image" src={heroImage} alt="Stylized adult fictional character in a red editorial portrait" widths={[640,960,1280,1536]} sizes="100vw" loading="eager" fetchpriority="high" quality={84} />
    <div class="hero-glow"></div>
    <div class="hero-copy reveal"><div class="kicker">Independent editorial overview</div><h1>OurDream AI</h1><p class="hero-tagline">Design a character. Build a whole world.</p><p>Explore OurDream AI character creation, companion chat, visual storytelling, privacy questions, Dreamcoin spending, and five distinct alternatives—before you commit.</p><div class="hero-actions"><a class="button primary" href="#features">Explore the experience <Icon name="spark" /></a><a class="button ghost" href="/blog/ourdream-ai-vs-candy-ai/">Read the comparison</a></div><div class="hero-trust"><span><Icon name="heart" /> Character-first</span><span><Icon name="chat" /> Story-focused</span><span><Icon name="lock" /> Privacy-aware</span><span>Independent editorial</span></div></div>

  </section>

  <section class="section intent-grid"><div><div class="section-label">01 / Understand the experience</div><h2>What makes <span>OurDream AI</span> different?</h2></div><div class="intent-copy"><p class="lead">OurDream AI is built around creating a fictional companion rather than simply opening a generic chatbot. Appearance, personality, conversation, and visual scenes work together as one story.</p><p>This independent OurDream AI guide helps you evaluate that experience using practical criteria: customization depth, roleplay continuity, image controls, credit costs, privacy, deletion, and how it compares with Candy AI, GirlfriendGPT and Replika.</p><div class="keyword-line"><span>OurDream AI review</span><span>AI companion chat</span><span>AI character creator</span><span>OurDream alternatives</span><span>roleplay privacy</span></div></div></section>

  <section class="section" id="features"><div class="section-head"><div><div class="section-label">02 / Core features</div><h2>From a profile to a <span>living character.</span></h2></div><p>The strongest companion platforms connect character design, conversation, and visual direction without making the setup feel like a form.</p></div><div class="feature-grid">
    <article class="feature reveal"><div class="feature-icon"><Icon name="wand" /></div><h3>Character creation</h3><p>Shape appearance, personality, tone, and scenario so the first conversation begins with a clear identity.</p><a href="#story">See the workflow <Icon name="arrow" /></a></article>
    <article class="feature reveal"><div class="feature-icon"><Icon name="chat" /></div><h3>Companion chat</h3><p>Test how well the character maintains voice, remembers fictional details, and follows story direction over time.</p><a href="/blog/ourdream-ai-vs-replika/">Compare chat styles <Icon name="arrow" /></a></article>
    <article class="feature reveal"><div class="feature-icon"><Icon name="spark" /></div><h3>Visual storytelling</h3><p>Evaluate scene consistency, credit usage, image controls, and whether the media supports the character you designed.</p><a href="/blog/ourdream-ai-vs-candy-ai/">Compare visual tools <Icon name="arrow" /></a></article>
  </div></section>

  <section class="section story" id="story"><div class="story-board"><div class="character-card"><small>CHARACTER BLUEPRINT</small><h3>Mira / Midnight City</h3><div class="trait"><span>Personality</span><b>Curious · Witty</b></div><div class="trait"><span>Story style</span><b>Slow-burn mystery</b></div><div class="trait"><span>Visual mood</span><b>Neon noir</b></div><div class="trait"><span>Memory test</span><b>Fiction only</b></div></div></div><div class="story-copy"><div class="section-label">03 / Better character design</div><h2>Start with a premise, <span>not a prompt dump.</span></h2><p>A concise character blueprint is easier for an AI companion to follow than a long list of conflicting traits.</p><ol class="steps"><li><span>01</span><div><strong>Choose one defining motivation</strong><p>Give the character a clear fictional goal that can drive several scenes.</p></div></li><li><span>02</span><div><strong>Add two compatible traits</strong><p>Pair characteristics that create a recognizable voice without constant contradiction.</p></div></li><li><span>03</span><div><strong>Define a safe story boundary</strong><p>Keep real identity details, private addresses, and confidential information outside the roleplay.</p></div></li></ol></div></section>  <section class="section" id="compare">
    <div class="section-head"><div><div class="section-label">05 / Five product comparisons</div><h2>OurDream AI vs. <span>five relevant alternatives.</span></h2></div><p>Compare the products by workflow, control, output quality, privacy, and realistic cost—not by a single promotional screenshot.</p></div>
    <div class="compare-table"><table><thead><tr><th>Product</th><th>Best fit</th><th>Main advantage</th><th>Detailed guide</th></tr></thead><tbody><tr><td><strong>OurDream AI</strong></td><td>visual character creation, companion chat, and long-form story roleplay</td><td>Use this as the baseline for all five tests</td><td><span class="badge">Primary guide</span></td></tr><tr><td><strong>Candy AI</strong></td><td>companion discovery and custom characters</td><td>Discover, Shorts, chat and media in one flow</td><td><a href="/blog/ourdream-ai-vs-candy-ai/">Read OurDream AI vs Candy AI →</a></td></tr><tr><td><strong>Replika</strong></td><td>one continuing AI friend</td><td>relationship-oriented conversation</td><td><a href="/blog/ourdream-ai-vs-replika/">Read OurDream AI vs Replika →</a></td></tr><tr><td><strong>CrushOn AI</strong></td><td>community character roleplay</td><td>model choice and public character discovery</td><td><a href="/blog/ourdream-ai-vs-crushon-ai/">Read OurDream AI vs CrushOn AI →</a></td></tr><tr><td><strong>Lovescape</strong></td><td>character, chat and media creation</td><td>connected image-to-video workflow</td><td><a href="/blog/ourdream-ai-vs-lovescape/">Read OurDream AI vs Lovescape →</a></td></tr><tr><td><strong>GirlfriendGPT</strong></td><td>community characters and roleplay</td><td>creator variety and rapid character browsing</td><td><a href="/blog/ourdream-ai-vs-girlfriendgpt/">Read OurDream AI vs GirlfriendGPT →</a></td></tr></tbody></table></div>
  </section>

  <section class="section seo-copy" aria-labelledby="ourdream-ai-fun-research">
    <div class="section-head"><div><div class="section-label">06 / Detailed OurDream AI research</div><h2 id="ourdream-ai-fun-research">A deeper OurDream AI guide <span>for careful comparison.</span></h2></div><p>This text-led section expands the practical questions people ask after the first product overview.</p></div>
    <figure class="seo-visual"><Image src={secondaryImage} alt="Stylized adult fictional character in a warm cinematic portrait" widths={[640,960,1280]} sizes="(max-width: 640px) 100vw, 1200px" loading="lazy" quality={84}/><figcaption><span>Character direction</span><strong>Distinct visual identities help test character consistency across scenes.</strong></figcaption></figure>
    <div class="seo-copy-grid">
      <article><h3>What to evaluate in a OurDream AI review</h3><p>A useful OurDream AI review should explain the actual job the product performs: visual character creation, companion chat, and long-form story roleplay. Look past headline feature counts and test whether the main workflow stays clear from setup to a usable result.</p><p>Our recommended method is to build a fictional adult character, test memory, and create matching scenes. Record setup time, consistency, failed attempts, feature limits, and the real cost of one repeatable session. That creates evidence you can compare instead of relying on marketing language.</p></article>
      <article><h3>OurDream AI features, cost, and output quality</h3><p>Feature availability and plan limits can change. Before paying, identify which actions are included, which consume credits or tokens, whether retries are charged, and whether exports carry restrictions. A low subscription price can become expensive when the workflow needs repeated generations.</p><p>Quality should mean more than visual polish. Score control, repeatability, continuity, speed, and how often the result is actually usable. Verify current pricing and plan details on the official service at checkout.</p></article>
      <article><h3>OurDream AI alternatives and privacy questions</h3><p>The five focused alternatives in this guide are Candy AI, Replika, CrushOn AI, Lovescape and GirlfriendGPT. They differ in character discovery, one-to-one companionship, model choice, visual production and creator-led roleplay. Match the product to the task you will repeat.</p><p>Before creating an account, review chat history, generated media, credit use, and account deletion. Use fictional or authorized inputs, avoid sensitive identifying details, and confirm how to remove content and close the account. Those checks are part of product quality, not an afterthought.</p></article>
    </div>
  </section>

  <section class="section privacy" id="privacy"><div class="privacy-copy"><div class="section-label">05 / Privacy before intimacy</div><h2>Keep the story vivid. <span>Keep your identity private.</span></h2><p>AI companion conversations can feel personal. Use fictional details, understand how history is stored, test deletion controls, and never treat an entertainment chatbot as confidential storage.</p><a class="button ghost" href="/blog/ourdream-ai-vs-candy-ai/">Open the privacy guide <Icon name="arrow" /></a></div><div class="privacy-card"><span>BEFORE YOU CHAT</span><h3>OurDream AI privacy checklist</h3><ul><li><b>01</b><span>Use a unique password and fictional profile details.</span></li><li><b>02</b><span>Check message, media, and account deletion controls.</span></li><li><b>03</b><span>Understand subscriptions, credits, and renewal.</span></li><li><b>04</b><span>Do not upload another person’s image without consent.</span></li><li><b>05</b><span>Keep medical, financial, and workplace secrets out.</span></li></ul></div></section>

  <section class="section"><div class="section-head"><div><div class="section-label">06 / OurDream AI blog</div><h2>Comparisons with <span>real decision criteria.</span></h2></div><a class="button ghost" href="/blog/">Browse every guide <Icon name="arrow" /></a></div><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>

  <section class="section faq"><div><div class="section-label">07 / Frequently asked</div><h2>OurDream AI <span>questions, answered.</span></h2></div><div class="faq-list">{faqs.map((faq)=><details><summary>{faq.question}<span>+</span></summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="section final-cta"><div><div class="section-label">MAKE THE COMPARISON YOURS</div><h2>Choose the experience that fits your story.</h2><p>Start with character quality, privacy, and total cost. Then visit the official product only when you know what you want to test.</p></div><a class="button primary" href={site.officialUrl} rel="noopener" target="_blank">Visit official OurDream AI <Icon name="arrow" /></a></section>
</BaseLayout>
