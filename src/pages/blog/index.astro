---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { site } from "../../data/site";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const jsonLd={"@context":"https://schema.org","@type":"CollectionPage",name:"OurDream AI comparisons and privacy guides",url:`${site.url}/blog/`,description:"Independent OurDream AI comparisons, privacy checklists, and character-creation advice.",hasPart:posts.map((post)=>({"@type":"Article",headline:post.data.title,url:`${site.url}/blog/${post.id}/`,datePublished:post.data.publishDate.toISOString()}))};
---
<BaseLayout title="OurDream AI Blog: Reviews, Comparisons & Privacy" description="Independent OurDream AI guides covering character creation, companion chat, privacy, pricing questions, Candy AI, GPTGirlfriend, and alternatives." keywords={["OurDream AI blog","OurDream AI comparison","OurDream AI alternatives","AI companion privacy"]} jsonLd={jsonLd}>
  <section class="page-hero"><div class="ambient-orb"></div><span>OURDREAM AI RESEARCH LIBRARY</span><h1>Build better characters.<br />Choose smarter tools.</h1><p>Original comparisons and practical privacy guides for evaluating OurDream AI and the wider companion-chat category.</p></section>
  <section class="section blog-list"><div class="post-grid">{posts.map((post,index)=><PostCard post={post} index={index} />)}</div></section>
</BaseLayout>
